# Copy this file to .env.local and fill in your real keys.
# DO NOT commit .env.local. Never use a VITE_ prefix for a secret: Vite can
# expose VITE_ variables to browser code.

# =============================================================================
# CCC Forensic Suite (agency) — existing product. Do not reuse these for DIY.
# =============================================================================
# Browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENTS_API_URL=

# Server-only values (Netlify Functions)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SENDGRID_API_KEY=
LOB_MODE=test
LOB_TEST_KEY=
LOB_LIVE_KEY=
# One value per Lob webhook, comma-separated when both Test and Live
# webhooks post to the same endpoint.
LOB_WEBHOOK_SECRET=

# =============================================================================
# Fieldwork DIY SaaS — ISOLATED lane (see docs/FIELDWORK_ISOLATION.md)
# Fieldwork functions NEVER fall back to the CCC keys above.
# Leave unset to run /diy.html in localStorage demo mode.
# =============================================================================
VITE_FIELDWORK_SUPABASE_URL=
VITE_FIELDWORK_SUPABASE_ANON_KEY=

FIELDWORK_SUPABASE_URL=
FIELDWORK_SUPABASE_ANON_KEY=
FIELDWORK_SUPABASE_SERVICE_ROLE_KEY=
FIELDWORK_ANTHROPIC_API_KEY=
FIELDWORK_LOB_MODE=test
FIELDWORK_LOB_TEST_KEY=
FIELDWORK_LOB_LIVE_KEY=
FIELDWORK_STRIPE_SECRET_KEY=
FIELDWORK_STRIPE_WEBHOOK_SECRET=
FIELDWORK_STRIPE_PRICE_STARTER=
FIELDWORK_STRIPE_PRICE_PRO=
FIELDWORK_STRIPE_PRICE_UNLIMITED=
