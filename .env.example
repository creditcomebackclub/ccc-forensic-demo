# Copy this file to .env.local and fill in your real keys.
# DO NOT commit .env.local. Never use a VITE_ prefix for a secret: Vite can
# expose VITE_ variables to browser code.

# Browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENTS_API_URL=

# Server-only values (Netlify Functions)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SENDGRID_API_KEY=
LOB_MODE=test
LOB_TEST_KEY=
LOB_LIVE_KEY=
# One value per Lob webhook, comma-separated when both Test and Live
# webhooks post to the same endpoint.
LOB_WEBHOOK_SECRET=

# NMI / Zen Payments (live card billing)
# Tokenization key is browser-safe (Collect.js). Security key is server-only.
VITE_NMI_TOKENIZATION_KEY=
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
NMI_WEBHOOK_SECRET=
# Default https://secure.nmi.com — use sandbox host when testing
NMI_API_URL=https://secure.nmi.com
# Flip to true only after sandbox proof; keeps cron/audit auto-charges dark until then
BILLING_AUTO_CHARGE=false
