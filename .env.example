# Copy this file to .env.local and fill in your real keys.
# DO NOT commit .env.local. Never use a VITE_ prefix for a secret: Vite can
# expose VITE_ variables to browser code.

# Browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENTS_API_URL=

# Server-only values (Netlify Functions)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Required when more than one admin exists. Public lead capture otherwise
# succeeds only when exactly one admin profile exists; it never guesses which
# administrator owns a lead.
PUBLIC_INTAKE_OWNER_USER_ID=
# Required when more than one admin exists. Public affiliate applications
# fail closed unless their exact program-owner UUID is configured.
AFFILIATE_PROGRAM_OWNER_USER_ID=

# Render authenticated client-concierge service (`agents/`)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
GOOGLE_API_KEY=
ALLOWED_ORIGINS=https://creditcomebackclub.com,https://ccc-forensic-demo.netlify.app

# Resend (CCC transactional email — separate team from Fieldwork)
# 1. Create a Resend account/team for Credit Comeback Club
# 2. Verify domain cccpartners.co (From: chris@cccpartners.co)
# 3. Create an API key → RESEND_API_KEY
# 4. Add a webhook to https://<site>/.netlify/functions/blueprint-email-events
#    for email.sent, email.delivered, email.delivery_delayed, email.bounced,
#    email.failed, email.complained, email.suppressed
# 5. Paste the webhook signing secret → RESEND_WEBHOOK_SECRET
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

LOB_MODE=test
LOB_TEST_KEY=
LOB_LIVE_KEY=
# One value per Lob webhook, comma-separated when both Test and Live
# webhooks post to the same endpoint.
LOB_WEBHOOK_SECRET=
